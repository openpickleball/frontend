{
	"name": "openpb-app",
	"version": "0.0.1",
	"private": true,
	"license": "AGPL-3.0-or-later",
	"type": "module",
	"packageManager": "pnpm@12.18.0",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"dev:stack": "bash scripts/dev-stack.sh",
		"build": "vite build",
		"check:build": "node scripts/check-build.mjs",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''; git config core.hooksPath .githooks || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && tsc -p src/service-worker --noEmit",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "eslint .",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"e2e": "playwright test",
		"e2e:live": "playwright test --config playwright.live.config.ts",
		"e2e:pwa": "playwright test --config playwright.pwa.config.ts",
		"icons": "node scripts/render-icons.mjs",
		"e2e:webkit": "E2E_WEBKIT=1 playwright test --project=\"iPhone 15\"",
		"api:pull": "node scripts/pull-open-schema.mjs && prettier --write src/lib/api/schema/open.json",
		"api:pull:allauth": "curl -fsS http://127.0.0.1:8000/_allauth/openapi.json -o src/lib/api/schema/allauth.json && prettier --write src/lib/api/schema/allauth.json",
		"api:gen": "openapi-typescript src/lib/api/schema/open.json -o src/lib/api/generated/open.d.ts && openapi-typescript src/lib/api/schema/allauth.json -o src/lib/api/generated/allauth.d.ts && prettier --write src/lib/api/generated"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.65.1",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.3.1",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "4.3.5",
		"@types/node": "^26.6.6",
		"@vitest/browser-playwright": "5.1.0",
		"@vitest/coverage-v8": "5.1.0",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-import-resolver-typescript": "^4.4.5",
		"eslint-plugin-boundaries": "^7.4.4",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"msw": "3.0.6",
		"openapi-msw": "2.1.1",
		"openapi-typescript": "7.13.0",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.2.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"tailwindcss": "4.3.5",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.73.0",
		"vite": "^8.3.8",
		"vitest": "^5.1.0",
		"vitest-browser-svelte": "^3.1.0"
	},
	"dependencies": {
		"@lucide/svelte": "^1.74.0",
		"bits-ui": "^2.21.0",
		"clsx": "^2.1.1",
		"openapi-fetch": "0.17.0",
		"svelte-sonner": "^1.2.3",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^4.0.2",
		"zod": "^4.6.7"
	}
}
